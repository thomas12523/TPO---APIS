    {
      "_id": "req_auth_register",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "1) REGISTRAR COMPRADOR (tomas123)",
      "method": "POST",
      "url": "{{ _.base_url }}/Auth/register",
      "body": { "mimeType": "application/json", "text": "{\n  \"dni\": 12345678,\n  \"username\": \"tomas123\",\n  \"email\": \"tomas@mail.com\",\n  \"nombre\": \"Tomas\",\n  \"apellido\": \"Pacheco\",\n  \"contrasenia\": \"123456\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.access_token) {\n  insomnia.environment.set('token', body.access_token);\n  console.log('token guardado (usuario normal)');\n}"
    },
    {
      "_id": "req_auth_register_vendedor",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "2) REGISTRAR VENDEDOR candidato (vendedor1) -- despues hay que promoverlo con SQL antes del login",
      "method": "POST",
      "url": "{{ _.base_url }}/Auth/register",
      "body": { "mimeType": "application/json", "text": "{\n  \"dni\": 87654321,\n  \"username\": \"vendedor1\",\n  \"email\": \"vendedor1@mail.com\",\n  \"nombre\": \"Vera\",\n  \"apellido\": \"Vendedora\",\n  \"contrasenia\": \"123456\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_auth_authenticate",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "3) LOGIN COMPRADOR (tomas123) -> guarda en 'token' -- NO editar el body, usar la request de abajo para vendedor",
      "method": "POST",
      "url": "{{ _.base_url }}/Auth/authenticate",
      "body": { "mimeType": "application/json", "text": "{\n  \"username\": \"tomas123\",\n  \"contrasenia\": \"123456\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.access_token) {\n  insomnia.environment.set('token', body.access_token);\n  console.log('token guardado (comprador)');\n}"
    },
    {
      "_id": "req_auth_authenticate_vendedor",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "4) LOGIN VENDEDOR (vendedor1, YA PROMOVIDO EN LA BASE) -> guarda en 'adminToken' -- usar ESTA, no la de arriba",
      "method": "POST",
      "url": "{{ _.base_url }}/Auth/authenticate",
      "body": { "mimeType": "application/json", "text": "{\n  \"username\": \"vendedor1\",\n  \"contrasenia\": \"123456\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.access_token) {\n  insomnia.environment.set('adminToken', body.access_token);\n  console.log('adminToken guardado (vendedor)');\n}"
    },
    {
      "_id": "req_err_login_mal",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "5) POST Auth/authenticate con contrasenia incorrecta -> 403",
      "method": "POST",
      "url": "{{ _.base_url }}/Auth/authenticate",
      "body": { "mimeType": "application/json", "text": "{\n  \"username\": \"tomas123\",\n  \"contrasenia\": \"incorrecta\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
